  "components": {
    "schemas": {
      "Accepted": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "const": "queued",
            "title": "Status",
            "default": "queued"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "Accepted"
      },
      "AnalysisResult": {
        "properties": {
          "engine": {
            "type": "string",
            "enum": [
              "scripted",
              "claude"
            ],
            "title": "Engine"
          },
          "hypotheses": {
            "items": {
              "$ref": "#/components/schemas/Hypothesis"
            },
            "type": "array",
            "title": "Hypotheses"
          },
