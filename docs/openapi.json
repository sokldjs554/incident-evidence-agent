              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "작업 조회 경로",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "팀 인증 필요",
            "content": {
