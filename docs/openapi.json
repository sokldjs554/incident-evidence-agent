  "webhooks": {
    "job.completed": {
      "post": {
        "summary": "Completed Event",
        "description": "워커가 CALLBACK_URL에 터미널 상태와 저장된 결과를 POST합니다. 동일 작업은 같은 키를 사용합니다.",
        "operationId": "completed_eventjob_completed_post",
        "parameters": [
          {
            "required": true,
            "schema": {
              "type": "string",
              "title": "Idempotency-Key"
            },
            "name": "idempotency-key",
            "in": "header"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TerminalJob"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "Idempotency-Key와 본문 작업 ID 불일치"
          },
          "409": {
            "description": "같은 ID로 다른 내용 전송"
          },
          "503": {
            "description": "테스트 수신기의 첫 전송 실패. 저장된 결과로 재시도",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
